# Dependencies
node_modules/

# Build output — regenerated by `npm run build`.
#
# Shipping this in git is unnecessary because `package.json` declares a
# `prepare` script: npm runs it after a git install, so a consumer that
# installs from a repository still gets a built `lib/`. The published tarball
# carries `lib/` via the `files` field, which `npm pack` fills from the working
# tree regardless of this ignore rule.
lib/

# Test coverage
coverage/

# Logs
*.log
npm-debug.log*

# Editor and OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local scratch — verification scripts and throwaway fixtures
.scratch/
.tmp/
*.tgz
